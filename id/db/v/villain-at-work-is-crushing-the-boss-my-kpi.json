{
  "judul": "Villain at Work! Is Crushing the Boss My KPI?",
  "judul_alternatif": "Penjahat di Kantor! Menghancurkan Bos Itu KPI-ku?",
  "thumb": "https://thumbnail.komiku.org/new/img/images/2026/05/13/20260513170055_9839eefbbe601034_c522c6e1.webp?w=1200",
