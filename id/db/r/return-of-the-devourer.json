{
  "judul": "Return of the Devourer",
  "judul_alternatif": "Kembalinya Sang Pemakan",
  "thumb": "https://thumbnail.komiku.org/img/upload/return_of_the_devourer/img_695b39b6f0d8f9.73172883.webp?w=1200",
  "tipe": "Manhua",
  "status": "Ongoing",
  "genre": [
