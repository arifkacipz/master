{
  "judul": "Osananajimi wo Miru Me ga Kawatte Shimatta",
  "judul_alternatif": "Cara Pandangku terhadap Sahabat Masa Kecil Berubah",
  "slug": "osananajimi-wo-miru-me-ga-kawatte-shimatta",
