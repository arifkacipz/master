{
  "judul": "The Immoral Duke Needs to Be Homeschooled",
  "judul_alternatif": "Adipati Tak Bermoral Harus Dididik di Rumah",
  "thumb": "https://thumbnail.komiku.org/new/img/images/2026/04/15/20260415153032_12192e31f1f25b9a_3d82392d.jpg?w=1200",
