{
  "judul": "The Regressed Son Of A Duke Is An Assassin",
  "judul_alternatif": "Putra Duke yang Kembali Menjadi Pembunuh",
  "thumb": "https://thumbnail.komiku.org/uploads/manga/the-regressed-son-of-a-duke-is-an-assassin/manga_thumbnail-Head-The-Regressed-Son-Of-A-Duke-Is-An-Assassin.jpg?w=1200",
