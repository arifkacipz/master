{
  "judul": "The Girl Who See It",
  "judul_alternatif": "Gadis yang Mampu Melihatnya",
  "thumb": "https://thumbnail.komiku.org/uploads/manga/the-girl-who-see-it/manga_thumbnail-Manga-The-Girl-Who-See-It.jpg?w=1200",
  "tipe": "Manga",
